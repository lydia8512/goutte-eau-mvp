# Environnement virtuel Python
.venv/

# Fichiers Python temporaires
__pycache__/
*.pyc
*.pyo

# Variables d'environnement et clés API
.env
.env.*
!.env.example

# Fichiers système
.DS_Store
Thumbs.db

# Fichiers temporaires VS Code
.vscode/

# Cache des tests
.pytest_cache/

# Fichiers de modèle temporaires
*.pkl
*.joblib

# Modèle final du MVP à versionner
!model/rain_model.joblib

# Base de données locale
*.db
*.sqlite
*.sqlite3

# Données brutes générées localement
data/raw/*.json

# Données préparées générées localement
data/processed/*.csv

# Dataset final du MVP à versionner
!data/processed/weather_dataset.csv